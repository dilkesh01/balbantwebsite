            function showToast(message) {
                toast.textContent = message;
                toast.classList.add('show');
                
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3000);
            }

            // Filter posts based on current filters
            function filterPosts() {
                // In a real app, you would fetch filtered posts from the server
                // For now, we'll just simulate it
                loadFeaturedPosts();
                loadRecentPosts();
            }

            // Load more posts
            function loadMorePosts() {
                const recentContainer = document.getElementById('recentPosts');
                const loader = document.getElementById('loadMoreBtn');
                
                // Show loading state
                loader.textContent = 'Loading...';
                loader.disabled = true;
                
                // Simulate API delay
                setTimeout(() => {
                    getMorePosts(currentPage, currentCategory, currentSearchQuery).then(posts => {
                        if (posts.length > 0) {
                            posts.forEach((post, index) => {
                                const postElement = createPostElement(post);
                                recentContainer.appendChild(postElement);
                            });
                            
                            // Hide loader if no more posts
                            if (posts.length < 3) { // Simulate reaching the end
                                loader.style.display = 'none';
                            } else {
                                loader.textContent = 'Load More';
                                loader.disabled = false;
                            }
                        } else {
                            showToast('No more posts to load');
                            loader.style.display = 'none';
                        }
                    });
                }, 1000);
            }

            // Load posts
            loadFeaturedPosts();
            loadRecentPosts();

            function loadFeaturedPosts() {
                const featuredContainer = document.getElementById('featuredPosts');
                
                getFeaturedPosts(currentCategory, currentSearchQuery).then(posts => {
                    featuredContainer.innerHTML = '';
                    
                    if (posts.length === 0) {
                        featuredContainer.innerHTML = '<p class="no-results">No featured posts found matching your criteria.</p>';
                        return;
                    }
                    
                    posts.forEach((post, index) => {
                        const postElement = createPostElement(post, true);
                        postElement.classList.add('animate', 'fade-in', `animate-delay-${index % 3}`);
                        featuredContainer.appendChild(postElement);
                    });
                });
            }

            function loadRecentPosts() {
                const recentContainer = document.getElementById('recentPosts');
                
                getRecentPosts(currentCategory, currentSearchQuery).then(posts => {
                    recentContainer.innerHTML = '';
                    
                    if (posts.length === 0) {
                        recentContainer.innerHTML = '<p class="no-results">No recent posts found matching your criteria.</p>';
                        loadMoreBtn.style.display = 'none';
                        return;
                    }
                    
                    posts.forEach((post, index) => {
                        const postElement = createPostElement(post);
                        postElement.classList.add('animate', 'fade-in', `animate-delay-${index % 3}`);
                        recentContainer.appendChild(postElement);
                    });
                    
                    // Show load more button if there might be more posts
                    if (posts.length >= 3) {
                        loadMoreBtn.style.display = 'block';
                    } else {
                        loadMoreBtn.style.display = 'none';
