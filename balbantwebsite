            categoryCards.forEach(card => {
                card.addEventListener('click', function() {
                    const category = this.getAttribute('data-category');
                    currentCategory = category;
                    currentPage = 1;
                    filterPosts();
                    showToast(`Filtering by category: ${category}`);
                });
